# Downloaded provider binaries — large, regenerated by `terraform init`
.terraform/

# Local state — contains real values, should never be committed for a
# multi-person or production setup. For this solo learning project we may
# choose to track it later for portfolio visibility, but default to ignoring.
*.tfstate
*.tfstate.*

# Plan output files, if we ever save one
*.tfplan

# Variable files that might hold secrets (none yet, but good habit)
*.auto.tfvars